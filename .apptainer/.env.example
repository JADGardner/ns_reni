# .apptainer/.env — host-specific paths (copy to .env and edit)
# These decouple the container from any specific filesystem layout.

# Where to store the built SIF and overlay (default: .apptainer/ directory)
# CONTAINER_DIR=/path/to/containers
# Or point directly at centrally managed files:
# SIF_FILE=/path/to/containers/ns_reni.sif
# OVERLAY_FILE=/path/to/containers/ns_reni_overlay.img

# Path to datasets (default: ./data)
DATA_PATH=/path/to/data

# Path to pretrained model checkpoints (default: ./checkpoints)
MODEL_STORAGE_PATH=/path/to/model-storage

# Path to training outputs (default: ./outputs)
OUTPUTS_PATH=/path/to/outputs
